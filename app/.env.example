# ==========================================
# ENV DO SISTEMA DE GESTÃO PARA ADVOCACIA
# ==========================================

# Chaves de Autenticação Supabase (Client-Side - Prefixo VITE_)
# Vá em Project Settings -> API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# Chave Admin do Supabase (Server-Side - NÃO usar prefixo VITE_)
# Vá em Project Settings -> API -> service_role secret
# ESSA CHAVE NÃO SERÁ EXPOSTA NO CLIENT
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_AQUI
